{
  "name": "@themvora/docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "predev": "pnpm search:generate",
    "prebuild": "pnpm search:generate",
    "build": "next build --turbopack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "variants:check": "node --experimental-strip-types scripts/check-code-variants.mjs",
    "compat:check": "node --experimental-strip-types scripts/check-code-compatibility.mjs",
    "codeblock:check": "node --experimental-strip-types scripts/check-code-block.mjs",
    "links": "node scripts/check-links.mjs",
    "redirects:check": "node scripts/check-redirects.mjs",
    "api:generate": "node scripts/generate-api-reference.mjs",
    "api:check": "node scripts/generate-api-reference.mjs --check",
    "cli:generate": "node scripts/generate-cli-reference.mjs",
    "cli:check": "node scripts/generate-cli-reference.mjs --check",
    "packages:generate": "node scripts/generate-package-graph.mjs",
    "packages:check": "node scripts/generate-package-graph.mjs --check",
    "apis:check": "node scripts/verify-package-apis.mjs",
    "examples:generate": "node scripts/generate-examples.mjs",
    "examples:check": "node scripts/generate-examples.mjs --check",
    "probe:hydration": "node scripts/probe-hydration.mjs",
    "probe:search": "node scripts/probe-search-dialog.mjs",
    "probe:toc-rail": "node scripts/probe-toc-rail.mjs",
    "probe:sidebar-scroll": "node scripts/probe-sidebar-scroll.mjs",
    "probe:scrollbar-color": "node scripts/probe-scrollbar-color.mjs",
    "probe:scrollbar-shot": "node scripts/probe-scrollbar-shot.mjs",
    "probe:examples-catalog": "node scripts/probe-examples-catalog.mjs",
    "probe:guide-first-success": "node scripts/probe-guide-first-success.mjs",
    "probe:playground-smoke": "node scripts/probe-playground-smoke.mjs",
    "probe:playground-presets": "node scripts/probe-playground-presets.mjs",
    "search:generate": "npx tsx scripts/generate-search-index.mjs",
    "search:test": "node scripts/test-search-index.mjs",
    "search:groups:test": "node --experimental-strip-types scripts/test-search-groups.mjs",
    "nav:test": "node --experimental-strip-types --test scripts/test-docs-nav.mjs",
    "probe:docs-nav": "node scripts/probe-docs-nav.mjs"
  },
  "dependencies": {
    "@themvora/core": "workspace:*",
    "@themvora/devtools": "workspace:*",
    "@themvora/next": "workspace:*",
    "@themvora/react": "workspace:*",
    "@themvora/tailwind": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^4.5.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@iconify/react": "^6.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "tailwindcss": "^4.3.3",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "^5.9.3"
  }
