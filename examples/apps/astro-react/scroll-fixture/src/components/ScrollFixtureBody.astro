---
// The tall, fully server-rendered page body every scroll variant shares.
//
// The landmarks are deliberately plain text: the gate identifies a frame as
// "top of page" when the top landmark is still in the viewport, so it must be
// visible without any client-side code.
interface Props {
  rows?: number;
}

const { rows = 60 } = Astro.props;
const middle = Math.floor(rows / 2);
---

<div id="top" class="row landmark">TOP LANDMARK</div>
{
  Array.from({ length: rows }, (_, i) => (
    <div
      id={i === middle ? "middle" : undefined}
      class:list={["row", { landmark: i === middle }]}
    >
      row {i + 1}
    </div>
  ))
}
<div id="bottom" class="row landmark">BOTTOM LANDMARK</div>
