{
  "name": "@themvora/app-svelte",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5192 --strictPort",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "preview": "vite preview --port 5192 --strictPort"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@themvora/app-shared": "workspace:*",
    "@themvora/core": "workspace:*",
    "@themvora/svelte": "workspace:*",
    "@themvora/tailwind": "workspace:*",
    "svelte": "^5.56.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
