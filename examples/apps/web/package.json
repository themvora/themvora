{
  "name": "@themvora/app-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Themvora Web Components first-paint example: plain HTML, automatic pre-paint CSS and boot script, no manual bootstrap.",
  "scripts": {
    "dev": "vite --port 5195 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 5195 --strictPort"
  },
  "dependencies": {
    "@themvora/core": "workspace:*",
    "@themvora/web": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  }
}
