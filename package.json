{
  "name": "themvora",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "description": "Themvora monorepo: the published packages live under packages/, the docs site under apps/docs.",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "test:scripts": "node --experimental-strip-types --test scripts/clean.test.mjs scripts/release/audit-production.test.mjs scripts/release/module-specifiers.test.mjs scripts/docs/check-examples.test.mjs scripts/docs/audits/audit-c-examples.test.mjs scripts/docs/audits/audit-css-snippets.test.mjs apps/docs/scripts/test-docs-nav.mjs",
    "test:search": "node apps/docs/scripts/test-search-index.mjs",
    "themvora:audit:presets": "node scripts/audit-presets.mjs",
    "themvora:audit:brands": "node scripts/audit-brand-references.mjs",
    "lint": "node scripts/lint.mjs",
    "themvora:audit:presets:strict": "node scripts/audit-presets.mjs --strict-ui",
    "release:audit": "node scripts/release/audit-packages.mjs && node scripts/release/audit-dependencies.mjs && node scripts/release/export-inventory.mjs && node scripts/release/verify-breaking-contract.mjs && node scripts/release/jsdoc-audit.mjs && node scripts/release/snippet-audit.mjs",
    "release:audit:deps": "node scripts/release/audit-dependencies.mjs",
    "audit:prod": "node scripts/release/audit-production.mjs",
    "release:audit:contract": "node scripts/release/verify-breaking-contract.mjs",
    "release:pack": "node scripts/release/pack-verify.mjs",
    "release:consumer": "node release-test/run.mjs",
    "release:test:deps": "node release-test/dependency-matrix/run.mjs",
    "release:api": "pnpm --filter @themvora/docs api:generate",
    "docs:public-api": "node scripts/docs/public-api.mjs",
    "docs:snippet-baseline": "node scripts/docs/snapshot-snippet-baseline.mjs",
    "docs:examples": "node scripts/docs/check-examples.mjs",
    "docs:examples:report": "node scripts/docs/check-examples.mjs --report",
    "docs:examples:update": "node scripts/docs/check-examples.mjs --update",
    "docs:sync-library-readmes": "node --experimental-strip-types scripts/generate-package-readmes.mjs",
    "docs:check-library-readmes": "node --experimental-strip-types scripts/check-readme-drift.mjs",
    "docs:audit:b": "node scripts/docs/audits/audit-b-package-to-docs.mjs",
    "docs:audit:c": "node scripts/docs/audits/audit-c-examples.mjs",
    "docs:audit:c:offline": "node scripts/docs/audits/audit-c-examples.mjs --offline",
    "docs:audit:c:dynamic": "node scripts/docs/audits/audit-c-examples.mjs --dynamic",
    "docs:audit:d": "node scripts/release/audit-dependencies.mjs",
    "docs:audit:e": "node scripts/docs/audits/audit-e-invented-symbols.mjs",
    "docs:audit:f": "node scripts/docs/audits/audit-f-internal-symbols.mjs",
    "docs:audit:g": "node scripts/docs/audits/audit-g-terminology.mjs",
    "docs:audit:h": "node scripts/docs/audits/audit-browser-smoke.mjs",
    "docs:audit:i": "node scripts/docs/audits/audit-i-generated-tables.mjs",
    "docs:audit:css": "node scripts/docs/audits/audit-css-snippets.mjs",
    "docs:audit:setup": "node scripts/docs/check-doc-setup-conventions.mjs",
    "docs:audit:install": "node --experimental-strip-types scripts/docs/audits/audit-installation-contracts.mjs",
    "docs:audit:ssr": "node --experimental-strip-types scripts/docs/audits/audit-ssr-metadata.mjs",
    "docs:audit:routes": "node apps/docs/scripts/check-redirects.mjs",
    "docs:audit:health": "node --experimental-strip-types scripts/docs/audits/audit-route-health.mjs",
    "docs:page-contracts": "node scripts/docs/audits/audit-page-contracts.mjs",
    "docs:release-gate": "node scripts/docs/release-gate.mjs",
    "docs:release-gate:browser": "node scripts/docs/release-gate.mjs --browser",
    "docs:release-gate:full": "node scripts/docs/release-gate.mjs --full",
    "docs:release-gate:all": "node scripts/docs/release-gate.mjs --full --dynamic",
    "verify:astro-readouts": "node scripts/release/verify-astro-readouts.mjs",
    "verify:remix-startup": "node scripts/release/verify-remix-startup.mjs",
    "verify:react-router-startup": "node scripts/release/verify-react-router-startup.mjs",
    "verify:react-first-paint": "node scripts/release/verify-react-first-paint.mjs",
    "verify:vanilla": "node scripts/release/verify-vanilla-prepaint.mjs",
    "verify:vanilla-vite": "node scripts/release/verify-vanilla-vite.mjs",
    "docs:api:check": "node apps/docs/scripts/generate-api-reference.mjs --check",
    "test:core": "pnpm --filter @themvora/core exec vitest run",
    "test:react": "pnpm --filter @themvora/react exec vitest run",
    "apps:react:dev": "pnpm --filter @themvora/app-react dev",
    "apps:react:build": "pnpm --filter @themvora/app-react build",
    "apps:build": "pnpm -r --filter \"./examples/apps/*\" run build",
    "apps:typecheck": "pnpm -r --filter \"./examples/apps/*\" run typecheck",
    "test:browser": "node scripts/web/browser-check.mjs",
    "test:browser:strict": "node scripts/web/browser-check.mjs --strict",
    "verify:astro-interaction": "node scripts/release/verify-astro-interaction.mjs",
    "verify:astro-scrollbar": "node scripts/release/verify-astro-scrollbar.mjs --app astro-native && node scripts/release/verify-astro-scrollbar.mjs --app astro-react",
    "verify:astro": "node scripts/release/verify-astro-interaction.mjs --app astro-native && node scripts/release/verify-astro-interaction.mjs --app astro-react && npm run verify:astro-scrollbar",
    "test:docs-nav": "node --experimental-strip-types --test apps/docs/scripts/test-docs-nav.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.10"
  }
}
