{
  "name": "@themvora/antd",
  "license": "MIT",
  "version": "1.4.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup src/index.ts --watch --format esm --dts",
    "test": "vitest"
  },
  "peerDependencies": {
    "@ant-design/cssinjs": "^2.0.0",
    "antd": "^6.0.0",
    "next": ">=15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@themvora/adapters": "workspace:^",
    "@themvora/core": "workspace:^"
  },
  "devDependencies": {
    "@ant-design/cssinjs": "2.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "antd": "^6.0.0",
    "next": "15.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vitest": "^4.0.0"
  },
  "description": "Ant Design adapter for Themvora.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themvora/themvora.git"
  },
  "homepage": "https://themvora-dev.vercel.app",
  "bugs": {
    "url": "https://github.com/themvora/themvora/issues"
  },
  "keywords": [
    "theme",
    "ant-design",
    "antd",
    "adapter",
    "theming"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
