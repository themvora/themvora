{
  "name": "@themvora/open-props",
  "license": "MIT",
  "version": "2.0.2",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/open-props.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./factory": {
      "types": "./dist/factory.d.ts",
      "import": "./dist/factory.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js"
    },
    "./open-props.css": "./dist/open-props.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup src/index.ts --watch --format esm --dts",
    "test": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vue": "^3.4.0",
    "svelte": "^5.0.0",
    "solid-js": "^1.8.0",
    "@angular/core": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@themvora/adapters": "workspace:^",
    "@themvora/core": "workspace:^"
  },
  "devDependencies": {
    "@angular/core": "^22.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "solid-js": "^1.9.18",
    "svelte": "^5.57.3",
    "vitest": "^4.0.0",
    "vue": "^3.4.0"
  },
  "description": "Open Props adapter for Themvora.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themvora/themvora.git"
  },
  "homepage": "https://themvora-dev.vercel.app",
  "bugs": {
    "url": "https://github.com/themvora/themvora/issues"
  },
  "keywords": [
    "theme",
    "open-props",
    "adapter",
    "theming"
  ],
  "publishConfig": {
    "access": "public"
  }
}
