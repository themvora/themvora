  "version": "1.3.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup src/index.ts --watch --format esm --dts",
    "test": "vitest"
  },
  "peerDependencies": {
    "@unocss/core": "^66.0.0",
    "unocss": "^66.12.0"
  },
  "dependencies": {
    "@themvora/adapters": "workspace:^",
    "@themvora/core": "workspace:^"
  },
  "devDependencies": {
    "unocss": "^66.12.0",
    "vitest": "^4.0.0"
  },
  "description": "UnoCSS adapter for Themvora.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themvora/themvora.git"
  },
  "homepage": "https://themvora-dev.vercel.app",
  "bugs": {
    "url": "https://github.com/themvora/themvora/issues"
  },
  "keywords": [
    "theme",
    "unocss",
    "adapter",
    "theming"
  ],
  "publishConfig": {
    "access": "public"
  }
}
