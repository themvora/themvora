{
  "name": "@themvora/angular",
  "license": "MIT",
  "version": "2.0.0",
  "description": "Angular integration for Themvora",
  "type": "module",
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "build:watch": "ng-packagr -p ng-package.json --watch",
    "test": "vitest"
  },
  "peerDependencies": {
    "@angular/core": ">=17.0.0",
    "@angular/common": ">=17.0.0"
  },
  "dependencies": {
    "@themvora/core": "workspace:^",
    "@themvora/web": "workspace:^",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@types/node": "^26.1.1",
    "ng-packagr": "^22.0.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.10"
  },
  "main": "./dist/fesm2022/themvora-angular.mjs",
  "module": "./dist/fesm2022/themvora-angular.mjs",
  "types": "./dist/types/themvora-angular.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/themvora-angular.d.ts",
      "esm": "./dist/fesm2022/themvora-angular.mjs",
      "default": "./dist/fesm2022/themvora-angular.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themvora/themvora.git"
  },
  "homepage": "https://themvora-dev.vercel.app",
  "bugs": {
    "url": "https://github.com/themvora/themvora/issues"
  },
  "keywords": [
    "theme",
    "angular",
    "theming",
    "dark-mode"
  ],
  "publishConfig": {
    "access": "public"
  }
}
