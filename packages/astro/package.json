{
  "name": "@themvora/astro",
  "license": "MIT",
  "version": "2.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "astro": "./src/provider.astro",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./provider.astro": "./src/provider.astro",
    "./ThemeToggle.astro": "./src/ThemeToggle.astro",
    "./ThemeFamilySelect.astro": "./src/ThemeFamilySelect.astro",
    "./ThemeScope.astro": "./src/ThemeScope.astro",
    "./ThemeInspector.astro": "./src/ThemeInspector.astro",
    "./ThemeScrollbar.astro": "./src/ThemeScrollbar.astro",
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "src/provider.astro",
    "src/ThemeToggle.astro",
    "src/ThemeFamilySelect.astro",
    "src/ThemeScope.astro",
    "src/ThemeInspector.astro",
    "src/ThemeScrollbar.astro",
    "src/integration.ts",
    "src/controller.ts",
    "src/bindings.ts",
    "src/dom.ts",
    "src/scrollbar-guard.ts",
    "src/theme-readout.tsx",
    "src/attributes.ts",
    "src/transport.ts",
    "src/runtime.ts",
    "src/navigation-script.ts",
    "src/server.ts",
    "src/client.tsx",
    "src/fingerprint.ts",
    "src/blocking-script.ts",
    "src/persistence.ts",
    "src/shared-runtime.ts",
    "src/hooks.ts",
    "src/theme-scope.tsx",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@themvora/core": "workspace:^",
    "@themvora/web": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "description": "Astro integration for Themvora.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themvora/themvora.git"
  },
  "homepage": "https://themvora-dev.vercel.app",
  "bugs": {
    "url": "https://github.com/themvora/themvora/issues"
  },
  "keywords": [
    "theme",
    "astro",
    "theming",
    "dark-mode"
  ],
  "publishConfig": {
    "access": "public"
  }
}
