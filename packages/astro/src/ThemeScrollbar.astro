---
import {
  type ScrollbarAppearanceOptions,
  type ScrollbarBehaviorOptions,
  type ScrollbarIconOptions,
  type ScrollbarScopeOptions,
} from "@themvora/core";
import { ThemvoraScrollbar } from "@themvora/web";

// SSR-safe (no-op on the server); the <script> below defines it in the browser.
ThemvoraScrollbar.define();

/**
 * Framework-neutral overlay scrollbar, as an Astro component.
 *
 * This is the wrapper `@themvora/core`'s overlay engine is meant to have per
 * framework — the same one `@themvora/react` exposes as `<ThemeScrollbar />`
 * and `@themvora/vue`/`@themvora/svelte` expose as their own components. It
 * renders the `<themvora-scrollbar>` custom element from `@themvora/web`, so
 * it needs no client framework: an Astro project with no islands at all can
 * still have the themed scrollbar.
 *
 * Pair it with `scrollbar` on `provider.astro` (or the `themvora({ scrollbar })`
 * integration option) so the native scrollbar is hidden *before* first paint —
 * that is what makes the overlay the only scrollbar from the first frame. This
 * component alone cannot do that: it mounts with the rest of the island layer,
 * which is after paint.
 *
 * It resolves the runtime from the nearest ancestor that has one — the
 * `<themvora-provider>` element, or the runtime `ThemeProviderClient` installs
 * (which `@themvora/astro` publishes on `<html>`).
 *
 * The props are the same four groups every other adapter uses. Astro has no
 * nested props on a custom element, so each group is flattened onto the
 * `<themvora-scrollbar>` attributes (`scope.include` → `include`, `icons.size`
 * → `icon-size`, a per-side `offset` object → `offset-<side>`, …).
 *
 * @example
 * ```astro
 * ---
 * import ThemeScrollbar from "@themvora/astro/ThemeScrollbar.astro";
 * ---
 * <ThemeScrollbar
 *   behavior={{ autoHide: true, smooth: true }}
 *   appearance={{ thickness: 10, radius: 999 }}
 *   scope={{ include: [".panel"] }}
 *   icons={{ up: "<b>^</b>", size: 12 }}
 * />
 * ```
 */
interface Props {
  /** How the overlay scrolls and hides. */
  behavior?: ScrollbarBehaviorOptions;
  /** The look and size of every rail. */
  appearance?: ScrollbarAppearanceOptions;
  /** Which scrollable containers the overlay tracks. */
  scope?: ScrollbarScopeOptions;
  /** Arrow button icons (HTML strings), plus the shared glyph `size`. */
  icons?: ScrollbarIconOptions<string>;
}

const props = Astro.props as Props;

/** Group key → the kebab-case attribute `<themvora-scrollbar>` reads. */
const ATTR: Record<string, string> = {
  autoHide: "auto-hide",
  autoHideDelay: "auto-hide-delay",
  hoverExpand: "hover-expand",
  draggable: "draggable",
  clickToJump: "click-to-jump",
  smooth: "smooth",
  overscroll: "overscroll",
  arrows: "arrows",
  thickness: "thickness",
  hoverThickness: "hover-thickness",
  radius: "radius",
  minThumbSize: "min-thumb-size",
  offset: "offset",
  trackOpacity: "track-opacity",
  thumbOpacity: "thumb-opacity",
  zIndex: "z-index",
  duration: "duration",
  animationDuration: "animation-duration",
  thumbColor: "thumb-color",
  trackColor: "track-color",
  activeThumbColor: "active-thumb-color",
  thumbHoverColor: "thumb-hover-color",
  touch: "touch",
  dir: "dir",
  axes: "axes",
  include: "include",
  exclude: "exclude",
};

/** Icons group key → attribute. */
const ICON_ATTR: Record<string, string> = {
  arrow: "arrow-icon",
  up: "arrow-up-icon",
  down: "arrow-down-icon",
  left: "arrow-left-icon",
  right: "arrow-right-icon",
  size: "icon-size",
};

const attrs: Record<string, string> = {};

function put(group: Record<string, unknown> | undefined) {
  for (const [key, value] of Object.entries(group ?? {})) {
    if (value == null) continue;
    const attr = ATTR[key];
    if (!attr) continue;
    // The per-side offset object cannot be a single attribute — emit one
    // `offset-<side>` attribute per side the object sets.
    if (key === "offset" && typeof value === "object") {
      for (const side of ["top", "right", "bottom", "left"] as const) {
        const sideValue = (value as Record<string, unknown>)[side];
        if (typeof sideValue === "number") attrs[`offset-${side}`] = String(sideValue);
      }
      continue;
    }
    if (Array.isArray(value)) {
      attrs[attr] = value.join(",");
      continue;
    }
    // Booleans are presence/absence attributes; a bare `auto-hide` means true.
    attrs[attr] = value === true ? "" : String(value);
  }
}

put(props.behavior as Record<string, unknown> | undefined);
put(props.appearance as Record<string, unknown> | undefined);
put(props.scope as Record<string, unknown> | undefined);

for (const [key, value] of Object.entries(props.icons ?? {})) {
  if (value == null) continue;
  const attr = ICON_ATTR[key];
  if (attr) attrs[attr] = String(value);
}
---

<themvora-scrollbar {...attrs}></themvora-scrollbar>

<script>
  import { ThemvoraScrollbar } from "@themvora/web";
  ThemvoraScrollbar.define();
</script>
