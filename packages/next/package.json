{
  "name": "@themvora/next",
  "license": "MIT",
  "version": "2.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest"
  },
  "peerDependencies": {
    "next": "^15.5.22 || ^16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@themvora/core": "workspace:^",
    "@themvora/react": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "description": "Next.js integration for Themvora with SSR-first theming and zero-flash bootstrapping.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themvora/themvora.git"
  },
  "homepage": "https://themvora-dev.vercel.app",
  "bugs": {
    "url": "https://github.com/themvora/themvora/issues"
  },
  "keywords": [
    "theme",
    "nextjs",
    "theming",
    "ssr",
    "dark-mode"
  ],
  "publishConfig": {
    "access": "public"
  }
}
