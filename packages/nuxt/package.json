{
  "name": "@themvora/nuxt",
  "license": "MIT",
  "version": "2.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest"
  },
  "peerDependencies": {
    "nuxt": ">=3.10.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@themvora/core": "workspace:^",
    "@themvora/vue": "workspace:^"
  },
  "devDependencies": {
    "@nuxt/kit": "^4.0.0",
    "@nuxt/schema": "^4.0.0",
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "description": "Nuxt module for Themvora: SSR, cookies, and zero-flash theming.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themvora/themvora.git"
  },
  "homepage": "https://themvora-dev.vercel.app",
  "bugs": {
    "url": "https://github.com/themvora/themvora/issues"
  },
  "keywords": [
    "theme",
    "nuxt",
    "theming",
    "ssr",
    "dark-mode"
  ],
  "publishConfig": {
    "access": "public"
  }
}
