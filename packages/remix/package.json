{
  "name": "@themvora/remix",
  "license": "MIT",
  "version": "2.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest"
  },
  "peerDependencies": {
    "@remix-run/react": "^2.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@themvora/core": "workspace:^",
    "@themvora/react": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "description": "Remix integration for Themvora.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themvora/themvora.git"
  },
  "homepage": "https://themvora-dev.vercel.app",
  "bugs": {
    "url": "https://github.com/themvora/themvora/issues"
  },
  "keywords": [
    "theme",
    "remix",
    "theming",
    "dark-mode"
  ],
  "publishConfig": {
    "access": "public"
  }
}
