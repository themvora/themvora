{
  "name": "@themvora/tailwind",
  "license": "MIT",
  "version": "1.3.1",
  "type": "module",
  "style": "./dist/index.css",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "style": "./dist/index.css",
      "import": "./dist/index.js"
    },
    "./theme.css": {
      "import": "./dist/theme.css",
      "default": "./dist/theme.css"
    },
    "./dark.css": {
      "import": "./dist/dark.css",
      "default": "./dist/dark.css"
    },
    "./preflight.css": {
      "import": "./dist/preflight.css",
      "default": "./dist/preflight.css"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup src/index.ts --watch --format esm --dts"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@themvora/core": "workspace:^"
  },
  "description": "Tailwind CSS v4 plugin that maps Themvora tokens to Tailwind theme variables.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themvora/themvora.git"
  },
  "homepage": "https://themvora-dev.vercel.app",
  "bugs": {
    "url": "https://github.com/themvora/themvora/issues"
  },
  "keywords": [
    "theme",
    "tailwindcss",
    "theming",
    "css-variables"
  ],
  "publishConfig": {
    "access": "public"
  }
}
