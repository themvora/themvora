{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Themvora: Extension Host",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/vscode"],
      "outFiles": ["${workspaceFolder}/packages/vscode/dist/**/*.js"],
      "preLaunchTask": "themvora-for-vscode: build"
    }
  ]
}
