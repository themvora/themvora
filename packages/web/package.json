{
  "name": "@themvora/web",
  "license": "MIT",
  "version": "1.6.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./boot.js": "./dist/boot.js"
  },
  "files": [
    "dist",
    "html-data.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest"
  },
  "dependencies": {
    "@themvora/core": "workspace:^"
  },
  "description": "HTML-first theme components for any page: custom elements, CSS variables and live configuration with no framework.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themvora/themvora.git"
  },
  "homepage": "https://themvora-dev.vercel.app",
  "bugs": {
    "url": "https://github.com/themvora/themvora/issues"
  },
  "keywords": [
    "theme",
    "theming",
    "vanilla-js",
    "dark-mode",
    "css-variables"
  ],
  "publishConfig": {
    "access": "public"
  }
}
